# Local dev and tests need none of this — no DATABASE_URL means src/db/client.ts
# falls back to an embedded PGlite database, auto-migrated and auto-seeded.
#
# Every AWS *credential* below, plus the three app secrets, is filled in for
# you. After a successful `pnpm infra:deploy`, the deploy wrapper reads that
# secret with the local `diveday-admin` profile and automatically writes
# `.env.local`, `.env.vercel`, and `.env.github`. The wizard can also write the
# generated AWS identities to named ~/.aws/credentials profiles. Set
# INFRA_ENV_SYNC_PROFILE if your administrator profile has a different name.
# The helper derives the three app secrets from a CDK-generated seed. Values
# that are a choice rather than a credential stay blank there too — SNS_SENDER_ID
# — as does anything the stack cannot know, such as DATABASE_URL and Stripe/Meta
# credentials. The comment above each says where it comes from.
#
# That document is generated *from this file*, so a variable added or renamed
# here shows up there on the next deploy. See docs/engineering/manual-actions.md.

# Production only. Vercel's Neon integration injects these automatically into
# the deployed environment; nothing to set by hand there. Only fill this file
# in if you're pointing a local run at a real Neon database on purpose.
# Pooled (PgBouncer) connection — used at request time (src/db/client.ts).
# If set manually, use sslmode=verify-full in the URL; the app normalizes legacy
# sslmode=require/prefer/verify-ca values to that explicit mode at runtime and
# during migrations.
DATABASE_URL=

# Direct/unpooled connection — used for schema migrations (`pnpm db:migrate`),
# since DDL over a transaction-mode pooler is unreliable. Neon calls this the
# "unpooled" connection string; falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# Required in production (NextAuth fails loudly without it there); dev/test
# fall back to a hardcoded non-production secret. The CDK-generated
# APP_SECRET_SEED below deterministically derives this value when the document
# is written by scripts/distribute-env.mjs. Do not generate or rotate it alone.
AUTH_SECRET=

# Transactional email through AWS SES (ADR 20260803-ses-sole-email-provider,
# superseding 20260802-ses-adapter-and-webhook). The friendly sender name is
# supported (for example, "Blue Mantis <bookings@ses.dive.day>"). Keep all
# four values server-only — none may use a NEXT_PUBLIC_ prefix. Credentials
# belong to the diveday-ses-sender IAM user (infra/lib/infra-stack.ts), never
# the cdk-deployer or reg-suit-bot credentials below. Also requires the AWS-side
# production-access request and DKIM DNS verification for ses.dive.day before
# real sending works — see docs/engineering/infrastructure-runbook.md.
SES_AWS_REGION=
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL="DiveDay <noreply@ses.dive.day>"

# SNS topic ARN for /api/webhooks/ses (SesEventNotificationsTopicArn output).
# Verified messages whose own TopicArn doesn't match this are rejected even if
# correctly signed, so a differently-sourced SNS message can't be replayed here.
SES_SNS_TOPIC_ARN=

# Canonical public origin used to build private waiver/readiness/recap links
# and the Stripe Connect OAuth callback. Must be a bare HTTPS origin — scheme
# https://, no username/password, no path, no query string, no fragment (e.g.
# `https://app.diveday.example`, never a trailing slash or `/some/path`).
# http://localhost or http://127.0.0.1 is accepted outside production only,
# for local Stripe Connect testing. The server fails to start if this is set
# to a malformed value; leaving it unset is fine and degrades affected
# features to "not configured".
APP_HOST=https://dive.day

# Certification review is manual: staff look a C-card number up with the issuing
# agency and mark it certified. There is no automated agency-verification
# integration and no environment configuration for one.

# Stripe Connect: shops bring their own Standard Stripe account (docs ADR
# 20260719-stripe-connect-orders). STRIPE_SECRET_KEY is the *platform*
# account's secret key — once a shop completes OAuth, this key can act on its
# behalf via a Stripe-Account header, so no per-shop credential is stored.
# STRIPE_CONNECT_CLIENT_ID comes from the platform's Connect OAuth settings
# (https://dashboard.stripe.com/settings/connect/onboarding-options/oauth).
# Register ${APP_HOST}/api/stripe/connect/callback there as the single OAuth
# redirect URL for every shop. Without both, the connect button and order
# creation report not_configured rather than half-working. Keep both Stripe
# secrets in 1Password; inject them into .env.local before this command. The
# distributor preserves them locally and includes them in .env.vercel, but they
# never enter the AWS credentials secret.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=ca_UvlITl41g1jCgVxyi3vqYguVm8l2dliH

# Signing secret for the Connect webhook endpoint (/api/webhooks/stripe),
# configured in the Stripe dashboard against that URL with "listen to events
# on Connected accounts" enabled. Without it, orders still work but their
# paid/void status only updates via the manual "Refresh status" action.
STRIPE_WEBHOOK_SECRET=

# Courtesy SMS reminders through AWS SNS (docs ADR 20260802-sns-sms-adapter).
# A distinct IAM user/credentials from SES_AWS_* (least privilege: sns:Publish
# only) — see infra/lib/infra-stack.ts's SnsSmsSenderUser. Missing credentials
# report not_configured rather than sending. SNS_SENDER_ID is an optional
# alphanumeric sender label; not supported in every country (notably the US).
SNS_AWS_REGION=
SNS_AWS_ACCESS_KEY_ID=
SNS_AWS_SECRET_ACCESS_KEY=
SNS_SENDER_ID=

# Amazon Location Service, for the settings address type-ahead
# (ADR 20260804-aws-location-address-lookup). Server-side only — there is no
# browser key, so nothing to referrer-restrict. Its own IAM user rather than
# the SES/SNS ones (least privilege: geo-places:Autocomplete and nothing else).
# Absent is a supported state: the address card falls back to plain text boxes.
PLACES_AWS_REGION=
PLACES_AWS_ACCESS_KEY_ID=
PLACES_AWS_SECRET_ACCESS_KEY=

# SMS delivery receipts (docs ADR 20260802-sms-delivery-receipts). SNS has no
# delivery webhook for a direct-to-phone Publish — receipts go to CloudWatch
# Logs — so an AWS-side forwarder republishes each one to this topic, which
# /api/webhooks/sms verifies with the same SNS envelope check the SES webhook
# uses. `SmsDeliveryReceiptsTopicArn` from the CDK stack. Unset, the endpoint
# answers 503 and sends still work; only the outcome is unknown.
SMS_SNS_TOPIC_ARN=

# WhatsApp via Meta Embedded Signup (docs ADR 20260802-whatsapp-embedded-signup,
# docs/engineering/whatsapp-cloud-api-runbook.md). These are DiveDay's own Meta
# app, not a shop's: every shop's WhatsApp Business Account is subscribed to it,
# which is what lets one webhook endpoint verify every shop's delivery events.
# Unset, the settings page shows "coming soon" and no shop can connect —
# Embedded Signup requires Meta app review and business verification first.
# META_WHATSAPP_WEBHOOK_VERIFY_TOKEN is any string you also enter in Meta's
# webhook configuration; it only guards the one-time subscription handshake.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_SIGNUP_CONFIG_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Encryption key for third-party credentials DiveDay stores on a shop's behalf
# — today, each shop's WhatsApp access token (docs ADR
# 20260802-whatsapp-cloud-api-per-shop). The target-file helper derives a
# distinct 32-byte base64 value from APP_SECRET_SEED.
# Unset, the WhatsApp settings page says so and refuses to store anything;
# nothing else in DiveDay is affected. Rotating this without re-sealing the
# existing rows degrades every connected shop back to SMS — see
# docs/engineering/whatsapp-cloud-api-runbook.md before rotating.
SECRET_ENCRYPTION_KEY=

# Error monitoring (docs ADR 20260727-sentry-error-monitoring-q7fk2p, docs/engineering/
# monitoring-runbook.md). A Sentry DSN is not a secret — it's meant to ship in client
# bundles — so this one value covers both the server and browser init. Without it, every
# Sentry call is a no-op and nothing is reported.
NEXT_PUBLIC_SENTRY_DSN=https://65d405fac65b4705122fac6512beae95@o4511809221427200.ingest.us.sentry.io/4511809222672384

# Scheduled pre-trip reminders (docs ADR 20260721-scheduled-reminder-cadence).
# Vercel Cron calls GET /api/cron/reminders daily with this as a bearer token
# (the Hobby plan caps crons at daily; the cadence buckets are >=24h wide so a
# daily run never misses one). The endpoint is unavailable (503) until this is
# set, so nothing can trigger reminder sends by accident. The target-file
# helper derives a distinct value from APP_SECRET_SEED.
CRON_SECRET=

# reg-suit visual regression testing via S3. The reg-suit-bot IAM user
# (infra/lib/infra-stack.ts §2). CI reads the same three as GitHub Actions
# repository secrets; this file is only for running `pnpm visual` locally.
# REG_SUIT_GITHUB_CLIENT_ID is the one value here the CDK stack does not supply
# — it comes from the reg-suit GitHub app.
REG_SUIT_S3_BUCKET_NAME=
REG_SUIT_AWS_ACCESS_KEY_ID=
REG_SUIT_AWS_SECRET_ACCESS_KEY=
REG_SUIT_GITHUB_CLIENT_ID=MzQ2MAICY1ND/ZTMstSUxEp9QxNLS1NzI0tTfcfEovw8p9KKpMTSXAA=

# CDK-generated root material for AUTH_SECRET, SECRET_ENCRYPTION_KEY, and
# CRON_SECRET. It is only an input to scripts/distribute-env.mjs: never put it
# in Vercel, GitHub, or another deployed environment.
APP_SECRET_SEED=
