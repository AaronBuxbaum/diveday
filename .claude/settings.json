{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Artifact",
      "ScheduleWakeup",
      "RemoteTrigger",
      "PushNotification",
      "ReportFindings",
      "WebSearch",
      "mcp__claude-code-remote",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm e2e)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(node scripts/screenshot.mjs:*)",
      "Bash(node scripts/stray-processes.mjs:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git remote -v)",
      "Bash(git stash list:*)",
      "Bash(git worktree list)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(pnpm task:context:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:changed)",
      "Bash(pnpm e2e:build)",
      "Bash(pnpm e2e:run *)",
      "Bash(pnpm visual:report *)",
      "Bash(pnpm gates)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "mcp__github",
      "Bash(node scripts/unfinished-promises.mjs:*)",
      "Bash(node scripts/unpushed-work.mjs:*)",
      "Bash(node scripts/session-context.mjs:*)",
      "Bash(node scripts/check-context-budget.mjs:*)",
      "Bash(node scripts/check-repo.mjs:*)",
      "Bash(node scripts/agent-health.mjs:*)",
      "Bash(node scripts/check-all.mjs:*)",
      "Bash(pnpm agent:health)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec biome check *)",
      "Bash(pnpm exec tsc *)"
    ],
    "deny": [
      "Read(.env.local)",
      "Read(.env.manual)",
      "Read(.env.vercel)",
      "Read(.env.github)",
      "Read(.env.production)",
      "Read(.env.development.local)",
      "Read(.pglite/**)",
      "Read(**/*.pem)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "env": {
    "NO_COLOR": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-context.mjs\"",
            "timeout": 300,
            "statusMessage": "Reading the checkout"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-context.mjs\" --prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/stray-processes.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/unfinished-promises.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/unpushed-work.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/stray-processes.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DIVEDAY_STRAY_PROCESS_MINUTES=0 node \"$CLAUDE_PROJECT_DIR/scripts/stray-processes.mjs\" --kill"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-read.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/format-touched.mjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/explain-failure.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "remoteControlAtStartup": true
}
