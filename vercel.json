{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "*": false,
      "main": true
    }
  },
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "7 14 * * *" },
    { "path": "/api/cron/trip-reminders", "schedule": "1 * * * *" },
    { "path": "/api/cron/recaps", "schedule": "2 * * * *" },
    { "path": "/api/cron/usage", "schedule": "7 9 * * *" },
    { "path": "/api/cron/retention", "schedule": "8 3 * * 0" },
    { "path": "/api/cron/dietary-retention", "schedule": "9 3 * * *" },
    { "path": "/api/cron/backup-export", "schedule": "7 4 * * 1" },
    { "path": "/api/cron/platform-backup", "schedule": "7 5 * * 1" },
    { "path": "/api/cron/trip-series", "schedule": "7 3 * * *" },
    { "path": "/api/cron/minimum-seats", "schedule": "0 * * * *" },
    { "path": "/api/cron/demo-refresh", "schedule": "8 9 * * *" },
    { "path": "/api/cron/integrations", "schedule": "3 * * * *" },
    { "path": "/api/cron/founder-metrics", "schedule": "7 11 * * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "4 * * * 0-2" },
    { "path": "/api/cron/crew-notices", "schedule": "6 * * * *" },
    { "path": "/api/cron/desk-pings", "schedule": "5 * * * *" },
    { "path": "/api/cron/bookkeeper", "schedule": "9 13 2,3 * *" },
    { "path": "/api/cron/pricing-volume", "schedule": "8 14,18,22 2,3 * *" }
  ]
}
