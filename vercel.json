{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 14 * * *" },
    { "path": "/api/cron/recaps", "schedule": "0 * * * *" },
    { "path": "/api/cron/usage", "schedule": "0 9 * * *" },
    { "path": "/api/cron/retention", "schedule": "30 3 * * 0" },
    { "path": "/api/cron/backup-export", "schedule": "0 4 * * 1" },
    { "path": "/api/cron/platform-backup", "schedule": "0 5 * * 1" },
    { "path": "/api/cron/trip-series", "schedule": "15 3 * * *" },
    { "path": "/api/cron/minimum-seats", "schedule": "20 * * * *" },
    { "path": "/api/cron/demo-refresh", "schedule": "45 3 * * *" }
  ]
}
