{
  // The service worker is the one place in this repo that is *not* a DOM
  // context. Typechecking it against `lib.dom` produces confident nonsense —
  // `self` is a Window, `ExtendableEvent` has no `waitUntil`, `caches` is the
  // page's — so it gets its own config with the WebWorker lib instead, and the
  // root tsconfig excludes it.
  //
  // `dom.iterable` is kept for the iteration helpers the store shares with the
  // page; `dom` itself is deliberately absent, because having both is what
  // makes `self` resolve to the wrong global.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "webworker", "dom.iterable"],
    // `node` only — for `process.env` in src/lib/clock.ts (esbuild defines it
    // away in the bundle) and for the node: imports that type-only edges reach.
    // Emphatically not the DOM types, which is the whole point of this config.
    "types": ["node"],
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  // Only the worker's own sources. TypeScript follows its imports from here, so
  // the store and its transitive deps are checked in this lib context without
  // dragging in every unrelated module under src/lib — auth config included,
  // whose next-auth type augmentation does not exist in a worker context.
  "include": ["./**/*.ts"],
  // The root config excludes `src/worker` (so its DOM libs never see this
  // file); inheriting that exclude here would leave this config with no inputs
  // at all.
  "exclude": ["../../node_modules"]
}
