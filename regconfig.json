{
  "core": {
    "workingDir": ".reg",
    "actualDir": "e2e/screenshots",
    "enableAntialias": true,
    "addExtraItems": true
  },
  "plugins": {
    "reg-simple-keygen-plugin": {
      "expectedKey": "${REG_EXPECTED_KEY}",
      "actualKey": "${REG_ACTUAL_KEY}"
    },
    "reg-publish-s3-plugin": {
      "bucketName": "$REG_SUIT_S3_BUCKET_NAME",
      "enableACL": false,
      "sdkOptions": {
        "region": "us-east-1",
        "credentials": {
          "accessKeyId": "$REG_SUIT_AWS_ACCESS_KEY_ID",
          "secretAccessKey": "$REG_SUIT_AWS_SECRET_ACCESS_KEY"
        }
      }
    },
    "reg-notify-github-plugin": {
      "clientId": "MzQ2MAICY1ND/ZTMstSUxEp9QxNLS1NzI0tTfcfEovw8p9KKpMTSXAA=",
      "setCommitStatus": false
    }
  }
}
