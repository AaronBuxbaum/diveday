{
  "core": {
    "workingDir": ".reg",
    "actualDir": "e2e/screenshots",
    "thresholdRate": 0.05,
    "addExtraItems": true
  },
  "plugins": {
    "reg-keygen-git-hash-plugin": {},
    "reg-publish-s3-plugin": {
      "bucketName": "$REG_SUIT_S3_BUCKET_NAME",
      "credentials": {
        "accessKeyId": "$REG_SUIT_AWS_ACCESS_KEY_ID",
        "secretAccessKey": "$REG_SUIT_AWS_SECRET_ACCESS_KEY"
      }
    }
  }
}
