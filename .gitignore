# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
/.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/e2e/screenshots/

# env files
.env*
!.env.example

# pglite dev database
/.pglite/
/.pglite-e2e/
/.pglite-visual/
/.reg/
/.reg-report/
/infra/dist/
/cdk.out/

# agent worktree scratch space (Claude Code isolation:"worktree")
/.claude/worktrees/

# throwaway screenshot drivers an agent writes to look at a page it just
# changed; the review is the point, the script is not worth keeping.
# scripts/screenshot.mjs is the kept tool that makes writing one unnecessary;
# its output lands here.
/.shots*.mjs
/screenshots/

# Built by scripts/build-service-worker.mjs from src/worker/manifest-sw.ts.
public/manifest-sw.js
