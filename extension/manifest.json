{
  "manifest_version": 3,
  "name": "DiveDay certification check",
  "short_name": "DiveDay check",
  "version": "1.6.0",
  "description": "Checks a diver's certification with their agency, PADI DiveChek included, and a course student's PADI eLearning, from DiveDay.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://my.divessi.com/*",
    "https://www.naui.org/*",
    "https://www.tdisdi.com/*",
    "https://www.gue.com/*",
    "https://portal.cmas.org/*",
    "https://pro.padi.com/*",
    "https://pros.padi.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://dive.day/shop/*"],
      "js": ["protocol.js", "bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
