{
  "//": "Only what scripts/check-route-coverage.mjs cannot derive from the tree. A route's specs, captures and a11y scans are read from the path literals in e2e/ (see that script); an entry here adds `e2e` specs and `visual` captures that reach the route by clicks a literal cannot show, `a11y` scans likewise, or an `exempt` reason saying why the route warrants less than both. `node scripts/check-route-coverage.mjs --write` prunes it; it never adds an exemption.",
  "/claim/[token]": {
    "visual": ["seat-claim"],
    "a11y": ["a11y.spec.ts"]
  },
  "/product/[feature]": {
    "visual": [
      "feature-boat-manifest",
      "feature-certifications",
      "feature-check-in",
      "feature-courses",
      "feature-dive-sites",
      "feature-messages",
      "feature-online-booking",
      "feature-payments",
      "feature-rental-gear",
      "feature-schedule",
      "feature-waivers",
      "feature-website"
    ]
  },
  "/ready/[token]": {
    "visual": [
      "booking-confirmed",
      "dock-day-legs",
      "expired-link-readiness",
      "party-organizer-confirmation",
      "readiness",
      "readiness-easing-back",
      "stranded-diver-card",
      "thread-anything-changed",
      "thread-prep-current-step"
    ],
    "a11y": ["a11y.spec.ts"]
  },
  "/ready/[token]/forms": {
    "visual": ["course-form-sign"]
  },
  "/s/[shopSlug]/embed/schedule": {
    "e2e": [
      "returning-diver.spec.ts",
      "reviews.spec.ts",
      "schedule-embed.spec.ts",
      "seo.spec.ts",
      "storefront-brand.spec.ts",
      "trip-admission.spec.ts"
    ],
    "visual": ["schedule-embed"]
  },
  "/s/[shopSlug]/trips/[id]/embed": {
    "e2e": ["returning-diver.spec.ts", "schedule-embed.spec.ts"],
    "visual": ["booking-confirmed-embed"]
  },
  "/shop/[shopSlug]/bookings/new/[tripId]": {
    "visual": ["booking-new-diver"]
  },
  "/shop/[shopSlug]/divers/[personId]": {
    "visual": [
      "diver-medical-clearance-form",
      "diver-medical-not-cleared",
      "diver-profile",
      "diver-profile-deleted",
      "diver-profile-erase-refused",
      "diver-profile-imported",
      "diver-profile-not-certified",
      "diver-profile-paper-waiver",
      "diver-profile-payments",
      "diver-record-bench",
      "diver-record-clear",
      "staff-diver-conversation"
    ]
  },
  "/shop/[shopSlug]/divers/[personId]/merge/[survivorId]": {
    "e2e": ["diver-merge.spec.ts"],
    "visual": ["diver-merge-preview"]
  },
  "/shop/[shopSlug]/divers/[personId]/waivers/[recordId]": {
    "e2e": ["waiver-print.spec.ts", "waivers.spec.ts"],
    "visual": ["diver-signed-waiver", "signed-waiver"]
  },
  "/shop/[shopSlug]/gear/[id]": {
    "e2e": ["boat-safety.spec.ts", "gear.spec.ts"],
    "visual": ["gear-unit", "gear-unit-deleted"]
  },
  "/shop/[shopSlug]/gear/rentals/[ticketId]": {
    "e2e": ["counter-rentals.spec.ts", "rental-terms.spec.ts"],
    "visual": ["counter-rental-ticket"]
  },
  "/shop/[shopSlug]/gear/work-orders/[workOrderId]": {
    "e2e": ["work-orders.spec.ts"],
    "visual": ["work-order-bill", "work-order-ticket"]
  },
  "/shop/[shopSlug]/gear/work-orders/[workOrderId]/tag": {
    "e2e": ["work-orders.spec.ts"],
    "visual": ["work-order-claim-tag"]
  },
  "/shop/[shopSlug]/orders/[id]": {
    "visual": ["order-detail", "order-detail-partly-refunded"]
  },
  "/shop/[shopSlug]/schedule/blowout/[tripId]": {
    "a11y": ["a11y.spec.ts"]
  },
  "/shop/[shopSlug]/schedule/blowout/day/[date]": {
    "visual": ["blowout-day"]
  },
  "/shop/[shopSlug]/settings/security": {
    "exempt": "Browser coverage is real (e2e/security-settings.spec.ts enrols in two-factor against the frozen clock, reads the recovery codes and revokes a session). No capture, because the Active sessions card cannot hold a baseline still: account_sessions.updated_at is stamped by better-auth's own clock, which DIVEDAY_CLOCK does not reach, so \"last seen\" is the wall clock; the row beside it prints the Chromium user-agent string, version and all; and the row count depends on how often the run signed in. Masking those is the one fix AGENTS.md refuses. Closing this means stamping those timestamps through src/lib/clock.ts at the better-auth boundary, which is an auth change wanting its own review (issue #1020)."
  },
  "/shop/[shopSlug]/trips/[id]": {
    "a11y": ["a11y.spec.ts"]
  },
  "/shop/[shopSlug]/trips/[id]/log": {
    "visual": ["departure-log", "departure-log-every-checkpoint"],
    "a11y": ["a11y.spec.ts"]
  },
  "/shop/[shopSlug]/trips/[id]/manifest": {
    "a11y": ["a11y.spec.ts"]
  },
  "/shop/[shopSlug]/trips/[id]/prep/ticket/[bookingId]": {
    "e2e": ["gear.spec.ts", "rental-terms.spec.ts"],
    "visual": ["rental-ticket"]
  },
  "/shop/[shopSlug]/trips/[id]/print": {
    "visual": ["trip-packet"]
  },
  "/shop/[shopSlug]/trips/[id]/walk-in": {
    "visual": ["trip-walk-in", "trip-walk-in-diver", "trip-walk-in-notice"],
    "a11y": ["a11y.spec.ts"]
  }
}
