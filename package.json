    "@sentry/nextjs": "^11.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aws-rum-web": "^3.2.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.14",
    "drizzle-orm": "1.0.0-rc.5",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
