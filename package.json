{
  "name": "diveday",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm build:sw && next dev",
    "build": "pnpm build:sw && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main --reporter=dot",
    "e2e:build": "pnpm build:sw && APP_HOST=https://e2e.diveday.example DATABASE_URL= DATABASE_URL_UNPOOLED= PGLITE_DATA_DIR=memory DIVEDAY_E2E=1 NEXT_PUBLIC_SENTRY_DSN= next build",
    "e2e:browser-check": "tsx scripts/ensure-playwright-browser.ts",
    "e2e": "pnpm e2e:browser-check && pnpm e2e:build && playwright test",
    "e2e:run": "pnpm e2e:browser-check && node scripts/check-e2e-build.mjs && playwright test",
    "visual": "pnpm e2e:browser-check && pnpm e2e:build && pnpm visual:run",
    "visual:run": "pnpm visual:capture && pnpm visual:compare",
    "visual:capture": "playwright test e2e/visual.spec.ts",
    "visual:compare": "dotenv -c -- reg-suit run",
    "visual:report": "node scripts/visual-report.mjs",
    "infra:bootstrap": "dotenv -c -- node scripts/infra-bootstrap.mjs",
    "infra:deploy": "dotenv -c -- node scripts/infra-deploy.mjs",
    "infra:synth": "dotenv -c -- node scripts/infra-cdk.mjs synth",
    "infra:diff": "dotenv -c -- node scripts/infra-cdk.mjs diff",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:clock": "node scripts/check-clock.mjs",
    "check:intl-cache": "node scripts/check-intl-cache.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:follow-ups": "node scripts/check-follow-ups.mjs",
    "check:e2e-fixtures": "node scripts/check-e2e-fixtures.mjs",
    "check:e2e-hygiene": "node scripts/check-e2e-hygiene.mjs",
    "check:route-coverage": "node scripts/check-route-coverage.mjs",
    "check:text": "node scripts/check-source-text.mjs",
    "check:infra-ascii": "node scripts/check-infra-ascii.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "check:timezone": "node scripts/check-timezone.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:domain-strings": "node scripts/check-domain-strings.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:open-graph": "node scripts/check-open-graph.mjs",
    "env:manual": "node scripts/env-manual.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "pnpm check:repo && pnpm lint && pnpm typecheck && pnpm test",
    "gates": "node scripts/gate-freshness.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "task:context": "node scripts/task-context.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate --config drizzle.config.prod.ts",
    "db:reset": "rm -rf .pglite && echo 'Dev database cleared; next `pnpm dev` re-migrates and re-seeds.'",
    "build:sw": "node scripts/build-service-worker.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1108.0",
    "@aws-sdk/client-geo-places": "^3.1108.0",
    "@aws-sdk/client-sesv2": "^3.1108.0",
    "@aws-sdk/client-sns": "^3.1108.0",
    "@electric-sql/pglite": "^0.5.4",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aws-rum-web": "^3.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "rc",
    "fflate": "^0.8.3",
    "next": "^16.3.0",
    "next-auth": "beta",
    "next-intl": "^4.13.6",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.8",
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "aws-cdk": "^2.1136.0",
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.8.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "rc",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "next-devtools-mcp": "^0.4.0",
    "playwright-core": "^1.62.1",
    "reg-keygen-git-hash-plugin": "^0.14.5",
    "reg-notify-github-plugin": "^0.14.5",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-suit": "^0.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vercel": "^58.9.5",
    "vitest": "^4.1.10"
  }
}
