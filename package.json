{
  "name": "diveday",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "DATABASE_URL= DATABASE_URL_UNPOOLED= PGLITE_DATA_DIR=.pglite-e2e DIVEDAY_E2E=1 next build",
    "e2e:browser-check": "node scripts/ensure-playwright-browser.mjs",
    "e2e": "pnpm e2e:browser-check && pnpm e2e:build && playwright test",
    "backstop": "node scripts/backstop-run.mjs test",
    "backstop:reference": "node scripts/backstop-run.mjs reference",
    "backstop:approve": "node scripts/backstop-run.mjs approve",
    "backstop:report": "backstop openReport --config=backstop.config.cjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:clock": "node scripts/check-clock.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:text": "node scripts/check-source-text.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:repo": "pnpm check:env && pnpm check:architecture && pnpm check:clock && pnpm check:adrs && pnpm check:docs && pnpm check:agents && pnpm check:text",
    "check": "pnpm check:repo && pnpm lint && pnpm typecheck && pnpm test",
    "perf:budget": "node scripts/perf-budget.mjs",
    "task:context": "node scripts/task-context.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.prod.ts",
    "db:reset": "rm -rf .pglite && echo 'Dev database cleared; next `pnpm dev` re-migrates and re-seeds.'"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@sentry/nextjs": "^10.68.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "next": "16.3.0-preview.9",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.0",
    "backstopjs": "^6.3.25",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
