{
  "name": "diveday",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm build:sw && node scripts/dev-server.mjs",
    "build": "pnpm build:sw && next build && pnpm build:sw:assets",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:rules": "biome lint --only=plugin src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:affected": "node scripts/test-affected.mjs",
    "test:changed": "vitest run --changed origin/main --reporter=dot",
    "verify:push": "node scripts/verify-push.mjs",
    "stack:sync": "node scripts/stack-sync.mjs",
    "e2e:affected": "node scripts/e2e-affected.mjs",
    "test:lib": "vitest run --project lib --reporter=dot",
    "coverage:floors": "vitest run --project '!guards' --reporter=dot --coverage.enabled && node scripts/coverage-floors.mjs",
    "test:mutation": "stryker run",
    "test:db": "vitest run --project db --reporter=dot",
    "test:ui": "vitest run --project ui --reporter=dot",
    "test:guards": "vitest run --project guards --reporter=dot",
    "e2e:build": "node scripts/e2e-build.mjs",
    "e2e:browser-check": "tsx scripts/ensure-playwright-browser.ts",
    "e2e": "pnpm e2e:browser-check && pnpm e2e:build && playwright test",
    "e2e:run": "pnpm e2e:browser-check && node scripts/check-e2e-build.mjs && playwright test",
    "visual": "pnpm e2e:browser-check && pnpm e2e:build && pnpm visual:run",
    "visual:run": "pnpm visual:capture && pnpm visual:compare",
    "visual:capture": "node scripts/check-e2e-build.mjs && playwright test e2e/visual",
    "visual:compare": "node scripts/visual-compare.mjs",
    "visual:layers": "node scripts/visual-diff-layers.mjs",
    "visual:report": "node scripts/visual-report.mjs",
    "visual:prune": "dotenv -c -- node scripts/prune-visual-bucket.mjs",
    "infra:bootstrap": "dotenv -c -- node scripts/infra-bootstrap.mjs",
    "infra:deploy": "dotenv -c -- node scripts/infra-deploy.mjs",
    "infra:migrate-region": "dotenv -c -- node scripts/migrate-region.mjs",
    "infra:synth": "dotenv -c -- node scripts/infra-cdk.mjs synth",
    "infra:diff": "dotenv -c -- node scripts/infra-cdk.mjs diff",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:tinted-ink": "node scripts/check-tinted-ink.mjs",
    "check:type-ramp": "node scripts/check-type-ramp.mjs",
    "check:page-length": "node scripts/check-page-length.mjs",
    "check:form-controls": "node scripts/check-form-controls.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "check:logical-properties": "node scripts/check-logical-properties.mjs",
    "check:image-sizes": "node scripts/check-image-sizes.mjs",
    "check:db-concurrency": "node scripts/check-db-concurrency.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:human-decisions": "node scripts/check-human-decisions.mjs",
    "check:design-canvases": "node scripts/check-design-canvases.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:follow-ups": "node scripts/check-follow-ups.mjs",
    "check:e2e-fixtures": "node scripts/check-e2e-fixtures.mjs",
    "check:critical-journeys": "node scripts/check-critical-journeys.mjs",
    "check:e2e-hygiene": "node scripts/check-e2e-hygiene.mjs",
    "check:route-coverage": "node scripts/check-route-coverage.mjs",
    "check:loading-skeletons": "node scripts/check-loading-skeletons.mjs",
    "check:staff-widths": "node scripts/check-staff-widths.mjs",
    "check:notice-codes": "node scripts/check-notice-codes.mjs",
    "check:rental-fit-caps": "node scripts/check-rental-fit-caps.mjs",
    "check:exit-curves": "node scripts/check-exit-curves.mjs",
    "check:text": "node scripts/check-source-text.mjs",
    "check:infra-ascii": "node scripts/check-infra-ascii.mjs",
    "check:sentry-imports": "node scripts/check-sentry-imports.mjs",
    "check:assist-prompts": "node scripts/check-assist-prompts.mjs",
    "check:tenant-gates": "node scripts/check-tenant-gates.mjs",
    "check:instant": "node scripts/check-instant.mjs",
    "check:shop-reads": "node scripts/check-shop-reads.mjs",
    "check:redirect-slugs": "node scripts/check-redirect-slugs.mjs",
    "check:capability-refusals": "node scripts/check-capability-refusals.mjs",
    "check:intl-providers": "node scripts/check-intl-providers.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "check:seat-word": "node scripts/check-seat-word.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:bundle-reach": "node scripts/check-bundle-reach.mjs",
    "check:closing-keywords": "node scripts/check-closing-keywords.mjs",
    "check:critical-text": "node scripts/check-critical-text.mjs",
    "check:domain-strings": "node scripts/check-domain-strings.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:migration-graph": "node scripts/check-migration-graph.mjs",
    "check:open-graph": "node scripts/check-open-graph.mjs",
    "check:node-version": "node scripts/check-node-version.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "env:manual": "node scripts/env-manual.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:env-reads": "node scripts/check-env-reads.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "cost:report": "node scripts/cost-report.mjs",
    "check": "node scripts/check-all.mjs",
    "gates": "node scripts/gate-freshness.mjs",
    "regen": "node scripts/regenerate.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "task:context": "node scripts/task-context.mjs",
    "db:generate": "drizzle-kit generate",
    "db:merge": "node scripts/merge-migration-heads.mjs",
    "db:migrate": "dotenv -c -- drizzle-kit migrate --config drizzle.config.prod.ts",
    "db:reset": "node scripts/db-reset.mjs",
    "billing:free-term": "dotenv -c -- tsx scripts/billing-free-term.ts",
    "billing:pricing-plan": "dotenv -c -- tsx scripts/billing-pricing-plan.ts",
    "billing:pricing-test": "dotenv -c -- tsx scripts/billing-pricing-test.ts",
    "build:sw": "node scripts/build-service-worker.mjs",
    "build:sw:assets": "node scripts/build-service-worker.mjs --assets",
    "brand:icons": "tsx scripts/render-brand-icons.tsx",
    "check:context-budget": "node scripts/check-context-budget.mjs",
    "agent:health": "node scripts/agent-health.mjs",
    "agent:doctor": "node scripts/agent-doctor.mjs",
    "simulate:day": "node scripts/simulate-day.mjs",
    "persona:bots": "node scripts/persona-bots.mjs",
    "content:photos": "tsx scripts/content-photos.ts",
    "content:coverage": "tsx scripts/content-coverage.ts",
    "ci:evidence": "node scripts/ci-evidence.mjs",
    "task:metrics": "node scripts/task-metrics.mjs",
    "agent:bootstrap": "node scripts/agent-bootstrap.mjs",
    "task:state": "node scripts/agent-task-state.mjs",
    "visual:review": "node scripts/visual-review.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1160.0",
    "@aws-sdk/client-geo-places": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-sesv2": "^3.1160.0",
    "@aws-sdk/client-sns": "^3.1160.0",
    "@electric-sql/pglite": "^0.5.13",
