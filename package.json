    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "msw": "^3.0.3",
    "next-devtools-mcp": "^0.4.0",
    "playwright-core": "^1.64.1",
    "postcss": "8.5.32",
    "reg-notify-github-plugin": "^0.14.5",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-simple-keygen-plugin": "^0.14.2",
    "reg-suit": "^0.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vercel": "^65.7.0",
    "vitest": "^5.0.5"
  }
