{
  "name": "diveday",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main --reporter=dot",
    "e2e:build": "APP_HOST=https://e2e.diveday.example DATABASE_URL= DATABASE_URL_UNPOOLED= PGLITE_DATA_DIR=memory DIVEDAY_E2E=1 next build",
    "e2e:browser-check": "tsx scripts/ensure-playwright-browser.ts",
    "e2e": "pnpm e2e:browser-check && pnpm e2e:build && playwright test",
    "e2e:run": "pnpm e2e:browser-check && node scripts/check-e2e-build.mjs && playwright test",
    "visual": "pnpm e2e:browser-check && pnpm e2e:build && pnpm visual:run",
    "visual:run": "pnpm visual:capture && pnpm visual:compare",
    "visual:capture": "playwright test e2e/visual.spec.ts",
    "visual:compare": "dotenv -c -- reg-suit run",
    "visual:report": "node scripts/visual-report.mjs",
    "infra:bootstrap": "dotenv -c -- cdk bootstrap",
    "infra:deploy": "dotenv -c -- cdk deploy",
    "infra:synth": "dotenv -c -- cdk synth",
    "infra:diff": "dotenv -c -- cdk diff",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:clock": "node scripts/check-clock.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "check:e2e-fixtures": "node scripts/check-e2e-fixtures.mjs",
    "check:route-coverage": "node scripts/check-route-coverage.mjs",
    "check:text": "node scripts/check-source-text.mjs",
    "check:locale": "node scripts/check-locale.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:domain-strings": "node scripts/check-domain-strings.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check": "pnpm check:repo && pnpm lint && pnpm typecheck && pnpm test",
    "gates": "node scripts/gate-freshness.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "task:context": "node scripts/task-context.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate --config drizzle.config.prod.ts",
    "db:reset": "rm -rf .pglite && echo 'Dev database cleared; next `pnpm dev` re-migrates and re-seeds.'"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1101.0",
    "@aws-sdk/client-sns": "^3.1101.0",
    "@electric-sql/pglite": "^0.5.4",
    "@sentry/nextjs": "^10.69.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "next": "16.3.0-preview.10",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.4",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "aws-cdk": "^2.1134.0",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "next-devtools-mcp": "^0.4.0",
    "reg-keygen-git-hash-plugin": "^0.14.5",
    "reg-notify-github-plugin": "^0.14.5",
    "reg-publish-s3-plugin": "^0.14.4",
    "reg-suit": "^0.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
