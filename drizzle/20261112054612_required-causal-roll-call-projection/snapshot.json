        "notNull": true
      }
    },
    {
      "op": "alter",
      "key": "columns\u0000[\"public\",\"roll_call_events\",\"causal_frontier\"]",
      "set": {
        "notNull": true
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"roll_call_events\",\"roll_call_events_readiness_snapshot_shape\"]",
      "set": {
        "value": "(\"readiness_status\" is null and \"readiness_blockers\" is null) or (\"subject_kind\" = 'seat' and coalesce(\"statement_status\", \"effective_status\") = 'boarded' and \"readiness_status\" in ('ready', 'blocked'))"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"roll_call_events\",\"roll_call_events_certification_snapshot_shape\"]",
      "set": {
        "value": "(\"certification_snapshot\" is null and \"certification_snapshot_started_at\" is null and \"certification_snapshot_captured_at\" is null) or (\"certification_snapshot\" is not null and \"certification_snapshot_started_at\" is not null and \"certification_snapshot_captured_at\" is not null and \"certification_snapshot_started_at\" <= \"certification_snapshot_captured_at\" and \"subject_kind\" = 'seat' and coalesce(\"statement_status\", \"effective_status\") = 'boarded' and \"checkpoint\" = 'departure' and \"source\" = 'live' and jsonb_typeof(\"certification_snapshot\") = 'array')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"roll_call_events\",\"roll_call_events_credential_snapshot_shape\"]",
      "set": {
        "value": "(\"credential_snapshot\" is null and \"credential_snapshot_started_at\" is null and \"credential_snapshot_captured_at\" is null) or (\"credential_snapshot\" is not null and \"credential_snapshot_started_at\" is not null and \"credential_snapshot_captured_at\" is not null and \"credential_snapshot_started_at\" <= \"credential_snapshot_captured_at\" and \"subject_kind\" = 'crew' and coalesce(\"statement_status\", \"effective_status\") = 'boarded' and \"checkpoint\" = 'departure' and \"source\" = 'live' and jsonb_typeof(\"credential_snapshot\") = 'array')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"roll_call_events\",\"roll_call_events_retracts_only_cleared\"]",
      "set": {
        "value": "\"retracts_event_id\" is null or coalesce(\"statement_status\", \"effective_status\") = 'cleared'"
      }
    }
  ]
