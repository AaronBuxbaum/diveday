        "table": "roll_call_event_claims",
        "name": "roll_call_event_claims_shape",
        "value": "(\n      \"state\" = 'erased' and \"subject_kind\" is null and \"booking_id\" is null and \"crew_person_id\" is null\n      and \"intent_fingerprint\" is null and \"proof_fingerprint\" is null and \"key_fingerprint\" is null and \"unresolved_reason\" is null\n      and \"note_disposition\" is null and \"accepted_event_id\" is null\n    ) or (\n      \"state\" in ('accepted', 'unresolved') and \"subject_kind\" is not null and \"intent_fingerprint\" is not null and \"proof_fingerprint\" is not null and \"key_fingerprint\" is not null\n      and ((\"subject_kind\" = 'seat' and \"booking_id\" is not null and \"crew_person_id\" is null)\n        or (\"subject_kind\" = 'crew' and \"crew_person_id\" is not null and \"booking_id\" is null))\n      and ((\"state\" = 'accepted' and \"accepted_event_id\" is not null and \"unresolved_reason\" is null)\n        or (\"state\" = 'unresolved' and \"accepted_event_id\" is null and \"unresolved_reason\" is not null))\n    )",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "roll_call_event_claims",
        "name": "roll_call_event_claims_reason",
        "value": "\"unresolved_reason\" is null or \"unresolved_reason\" in ('meeting_identity_unverified', 'unresolved_predecessor')",
        "entityType": "checks"
      }
