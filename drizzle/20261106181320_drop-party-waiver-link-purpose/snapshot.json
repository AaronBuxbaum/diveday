  "deltas": [
    {
      "op": "alter",
      "key": "enums\u0000[\"public\",\"capability_purpose\"]",
      "set": {
        "values": [
          "interest_unsubscribe",
          "courtesy_email_unsubscribe",
          "weekly_digest_unsubscribe",
          "shore_alert_stop",
          "bookkeeper_stop",
          "shore_alert_confirm",
          "email_verification",
          "password_reset",
          "invite",
          "shop_setup",
          "calendar_assignments",
          "calendar_shop_trips",
          "waiver_link",
          "release_link"
        ]
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"capabilities\",\"capabilities_subject_by_purpose\"]",
      "set": {
        "value": "(\"purpose\"::text in ('interest_unsubscribe') and \"interest_id\" is not null and \"person_id\" is null and \"sent_to\" is null and \"user_account_id\" is null and \"setup_request_id\" is null and \"waiver_record_id\" is null)\n        or (\"purpose\"::text in ('courtesy_email_unsubscribe', 'weekly_digest_unsubscribe', 'calendar_assignments', 'calendar_shop_trips') and \"person_id\" is not null and \"interest_id\" is null and \"sent_to\" is null and \"user_account_id\" is null and \"setup_request_id\" is null and \"waiver_record_id\" is null)\n        or (\"purpose\"::text in ('shore_alert_stop', 'bookkeeper_stop', 'shore_alert_confirm') and \"sent_to\" is not null and \"sent_to\" = lower(\"sent_to\") and \"person_id\" is null and \"interest_id\" is null and \"user_account_id\" is null and \"setup_request_id\" is null and \"waiver_record_id\" is null)\n        or (\"purpose\"::text in ('email_verification', 'password_reset', 'invite') and \"user_account_id\" is not null and \"person_id\" is null and \"interest_id\" is null and \"sent_to\" is null and \"setup_request_id\" is null and \"waiver_record_id\" is null)\n        or (\"purpose\"::text in ('shop_setup') and \"setup_request_id\" is not null and \"person_id\" is null and \"interest_id\" is null and \"sent_to\" is null and \"user_account_id\" is null and \"waiver_record_id\" is null)\n        or (\"purpose\"::text in ('waiver_link', 'release_link') and \"waiver_record_id\" is not null and \"person_id\" is null and \"interest_id\" is null and \"sent_to\" is null and \"user_account_id\" is null and \"setup_request_id\" is null)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"capabilities\",\"capabilities_used_only_when_spent\"]",
      "set": {
        "value": "\"used_at\" is null or \"purpose\"::text in ('shore_alert_stop', 'bookkeeper_stop', 'shore_alert_confirm', 'email_verification', 'password_reset', 'invite', 'shop_setup', 'waiver_link', 'release_link')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"capabilities\",\"capabilities_expiry_by_purpose\"]",
      "set": {
        "value": "(\"expires_at\" is not null) = (\"purpose\"::text in ('shore_alert_confirm', 'email_verification', 'password_reset', 'invite', 'shop_setup', 'waiver_link', 'release_link'))"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"capabilities\",\"capabilities_claim_only_when_claimable\"]",
      "set": {
        "value": "\"claim_hash\" is null or \"purpose\"::text in ('waiver_link')"
      }
    }
  ]
