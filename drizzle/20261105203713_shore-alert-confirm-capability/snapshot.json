    {
      "op": "alter",
      "key": "enums\u0000[\"public\",\"capability_purpose\"]",
      "set": {
        "values": [
          "interest_unsubscribe",
          "courtesy_email_unsubscribe",
          "weekly_digest_unsubscribe",
          "shore_alert_stop",
          "bookkeeper_stop",
          "shore_alert_confirm"
        ]
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"capabilities\",\"capabilities_subject_by_purpose\"]",
      "set": {
        "value": "(\"purpose\"::text in ('interest_unsubscribe') and \"interest_id\" is not null and \"person_id\" is null and \"sent_to\" is null)\n        or (\"purpose\"::text in ('courtesy_email_unsubscribe', 'weekly_digest_unsubscribe') and \"person_id\" is not null and \"interest_id\" is null and \"sent_to\" is null)\n        or (\"purpose\"::text in ('shore_alert_stop', 'bookkeeper_stop', 'shore_alert_confirm') and \"sent_to\" is not null and \"sent_to\" = lower(\"sent_to\") and \"person_id\" is null and \"interest_id\" is null)"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"capabilities\",\"capabilities_used_only_when_spent\"]",
      "set": {
        "value": "\"used_at\" is null or \"purpose\"::text in ('shore_alert_stop', 'bookkeeper_stop', 'shore_alert_confirm')"
      }
    }
